{
    "name": "calien/phpunit-deprecation-causer",
    "description": "PHPUnit extension reporting deprecations that first-party code causes through third-party code, while ignoreIndirectDeprecations keeps suppressing everything else.",
    "license": "GPL-2.0-or-later",
    "type": "library",
    "keywords": [
        "phpunit",
        "phpunit-extension",
        "deprecation",
        "typo3"
    ],
    "authors": [
        {
            "name": "Markus Hofmann",
            "email": "markus.hofmann@calien.de",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "phpunit/phpunit": "^12.5.13"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Calien\\PhpUnitDeprecationCauser\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Calien\\PhpUnitDeprecationCauser\\Tests\\": "tests/"
        }
    },
    "config": {
        "bin-dir": "bin",
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "12.x-dev": "12.0.x-dev"
        }
    }
}
